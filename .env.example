APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Версия для query string у CSS/JS гостевой части (кэш браузера после деплоя). Если пусто — запасной вариант в шаблоне.
# ASSET_VERSION=2026-04-12

# Яндекс.Метрика (подгружается после согласия с cookie)
# YANDEX_METRIKA_ID=106896230

# Локализация: интерфейс (LOCALE), запасной язык при отсутствии перевода (FALLBACK), фейкер в сидерах (FAKER)
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Опционально: адрес для ссылки «Поддержка» в ЛК (mailto:); по умолчанию = MAIL_FROM_ADDRESS
# MAIL_SUPPORT_ADDRESS=support@example.com
# Получатели писем обратной связи (через запятую — несколько адресов)
MAIL_CONTACT_RECIPIENTS=nexus@nexus-invest.fund
# false = отправка сразу (Beget без queue:work); true = через очередь
MAIL_QUEUE_OUTBOUND=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cookie banner: ссылки на документы (по умолчанию — doc/NexusPrivacyPolicy-14022026.pdf и doc/NexusUserAgreement-15022026.pdf)
# COOKIE_PRIVACY_POLICY_URL=doc/NexusPrivacyPolicy-14022026.pdf
# COOKIE_TERMS_URL=doc/NexusUserAgreement-15022026.pdf

# TrueConf Server (мессенджер: чат и звонки)
TRUECONF_BASE_URL=https://mess.nexus-invest.fund
TRUECONF_CLIENT_ID=
TRUECONF_CLIENT_SECRET=
# Для метода Authorization Code (опционально):
# TRUECONF_REDIRECT_URI=https://nexus-invest.fund/lk/messenger/callback
# При cURL error 60 (SSL certificate) на локальной машине — отключить проверку SSL (только для разработки):
# TRUECONF_VERIFY_SSL=false
