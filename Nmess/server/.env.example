PORT=3001
NODE_ENV=development
# URL Laravel API для проверки токена и прав (например https://nexus.example/api)
LARAVEL_API_URL=http://127.0.0.1:8000
# Секрет для проверки JWT (должен совпадать с Laravel APP_KEY или отдельный ключ для Nmess)
JWT_SECRET=
# Включить проверку прав через Laravel при создании комнаты/звонка (true/false)
CHECK_RIGHTS_VIA_API=true
